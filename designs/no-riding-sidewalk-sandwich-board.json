        "flat design",
        "high contrast",
        "readable from 25 feet",
        "prohibition sign",
        "public safety",
        "weatherproof signage",
        "clean sans-serif"
      ]
    },
    "handles": {
      "swap_primary_vehicle": "Replace icon_primary_bicycle silhouette (bike | scooter | skateboard | e-bike) without touching layout.",
      "recolor_band": "Change bands.safety_band.fill.colors for a different jurisdiction palette.",
      "localize_authority": "Add an optional footer text layer with city/park name or ordinance number.",
      "tone_shift": "Swap cta content between 'THANK YOU' (friendly) and 'FINE $XX' (enforcement)."
    },
    "constraints": {
      "lock_text_content": true,
      "lock_brand_elements": true,
      "allow_color_variation": false,
      "allow_layout_adjustment": "minor",
