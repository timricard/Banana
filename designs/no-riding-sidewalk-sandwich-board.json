{
  "social_graphic": {
    "meta": {
      "spec_version": "2.0.0",
      "title": "No Riding on the Sidewalk - A-Frame Sandwich Board",
      "campaign": "sidewalk_safety",
      "brand_name": "City Sidewalk Safety",
      "usage_context": "print_signage",
      "description": "Weatherproof A-frame sandwich board that instructs cyclists, scooter, skateboard, and e-bike riders to dismount and walk on the sidewalk. Rendered on location on a real sidewalk for context."
    },
    "platform": "custom",
    "dimensions": {
      "width": 1200,
      "height": 1800,
      "unit": "px",
      "print_size": "24in x 36in portrait face, 300 DPI",
      "notes": "Single face; duplicate identically on both A-frame panels. Bleed 0.125in on all sides."
    },
    "render_context": {
      "scene": "A-frame sandwich board standing on a clean concrete sidewalk, mid-morning soft daylight, shallow depth of field with a softly blurred street background",
      "camera": {
        "angle": "three_quarter_front",
        "framing": "medium_wide",
        "focal_length_mm": 50,
        "eye_level": "slightly_above_sign"
      },
      "grounding": ["soft contact shadow beneath frame", "visible A-frame hinge and rear leg"]
    },
    "background": {
      "type": "solid",
